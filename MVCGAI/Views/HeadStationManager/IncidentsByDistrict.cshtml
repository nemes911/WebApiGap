@{
    ViewData["Title"] = "Районы и инценденты";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid">
    <div class="row">
        <div class="col-12 bg-dark text-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h3>Панель районов</h3>
                <div>
                    <span class="me-3">Пользователь: <b>@ViewBag.Username</b></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <h4>Реестер инцендентов на район</h4>
            @if(ViewBag.Error != null)
            {
                <div class="alert alert-danger" style="white-space: pre-line; font-family: monospace; font-size: 0.9rem;">
                    @ViewBag.Error
                </div>
            }
            <table class="table table-striped table-hover">
                <thead>
                    <tr>

                        <th> Инцендент по району</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.IncidentsByDistrict != null)
                    {
                        foreach (var inc in ViewBag.IncidentsByDistrict)
                        {
                            <tr>
                                <td>@inc.Incident_Date</td>
                                <td>@inc.Description</td>
                                <td>@inc.Repair_cost</td>
                                <td>@inc.TimeStamp</td>
                                <td>@inc.Location</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>


</div>