@{
    ViewData["Title"] = "Панель администратора";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12 bg-dark text-white py-3">
            <div class="d-flex justify-content-between  align-items-center">
                <h3>Панель администрирования</h3>
                <div>
                    <span class="me-3">Пользователь: <b>@ViewBag.Username</b></span>
                </div>
            </div>

        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <h4>Реестер районов</h4>
             @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" style="white-space: pre-line; font-family: monospace; font-size: 0.9rem;">
                    @ViewBag.Error
                </div>
            }

            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Название района</th>

                    </tr>
                   
                </thead>
                <tbody>
                    @if(ViewBag.Districts != null)
                    {
                        foreach(var d in ViewBag.Districts)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="HeadStationManager"
                                       asp-action="IncidentsByDistrict"
                                    asp-route-id="@d.Id">
                                    @d.Name

                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center">Нет данных</td></tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>