@page "/map"

@inject SessionService session


<div class="header">
    RMS System — Personal Search
</div>

<div class="container"/>

<div class="search-box"/>

<h3>Person Search</h3>

<div class="form-row">
<label>Last Name</label>
<input id="lastName">
</div>

<div class="form-row">
<label>First Name</label>
<input id="firstName">
</div>

<div class="form-row">
<label>Date of Birth</label>
<input type="date" id="dob">
</div>


<h3>Map</h3>

@if (session.IsAuthenticated)
{
    <div class="global-footer">
        User: @session.name
        <br />
        Role: @session.role
        <br />
        Session: @session.id
    </div>
}
else
{
    <div>
        Not authenticated
    </div>
}
