@page "/dashboard"   
@using BlazorApp1.DTO.Request
@inject IHttpClientFactory HttpClientFactory
@inject Key Key
@inject NavigationManager nav

<h3 class="mb-3">Дашборд</h3>

<div class="row g-3">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card p-3">
            <div class="text-muted small">Сегодня</div>
            <div class="fs-2 fw-semibold">@_todayCount</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card p-3">
            <div class="text-muted small">За месяц</div>
            <div class="fs-2 fw-semibold">@_rangeCount</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card p-3">
            <div class="text-muted small">Стоимость ремонта</div>
            <div class="fs-2 fw-semibold">@_totalRepairCost</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card p-3">
            <div class="text-muted small">Общая сумма</div>
            <div class="fs-2 fw-semibold">@_totalRepairCost</div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <div class="fw-semibold">Недавние ДТП</div>
                    <div class="text-muted small">За последние 7 дней</div>
                </div>
                <a class="btn btn-sm btn-outline-primary" href="/incidents">Все →</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 120px;">Дата</th>
                            <th>Описание</th>
                            <th style="width: 220px;">Авто</th>
                            <th style="width: 160px;">Стоимость</th>
                            <th style="width: 180px;">Страховка / VIN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr>
                                <td colspan="5" class="text-muted">Загрузка…</td>
                            </tr>
                        }
                        else if (!string.IsNullOrWhiteSpace(_error))
                        {
                            <tr>
                                <td colspan="5" class="text-danger">@_error</td>
                            </tr>
                        }
                        else if (_nearIncidents.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-muted">Нет данных за выбранный период.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var i in _nearIncidents)
                            {
                                <tr>
                                    <td>@i.incident_date.ToString("dd.MM.yyyy")</td>
                                    <td class="text-truncate" style="max-width: 420px;">@i.description</td>
                                    <td>
                                        <div class="fw-semibold">@i.car_brand</div>
                                        <div class="text-muted small">№ @i.serial_number • @i.color</div>
                                    </td>
                                    <td>@FormatMoney(i.repair_cost)</td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 260px;">@i.insurance_company</div>
                                        <div class="text-muted small text-truncate" style="max-width: 260px;">@i.vin</div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="card p-3">
            <div class="fw-semibold mb-2">ДТП за сегодня</div>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 120px;">Дата</th>
                            <th>Локация</th>
                            <th>Описание</th>
                            <th style="width: 160px;">Стоимость</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loadingToday)
                        {
                            <tr>
                                <td colspan="4" class="text-muted">Загрузка…</td>
                            </tr>
                        }
                        else if (!string.IsNullOrWhiteSpace(_errorToday))
                        {
                            <tr>
                                <td colspan="4" class="text-danger">@_errorToday</td>
                            </tr>
                        }
                        else if (_todayIncidents.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-muted">Сегодня ДТП не зарегистрированы.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var i in _todayIncidents)
                            {
                                <tr>
                                    <td>@i.IncidentDate.ToString("dd.MM.yyyy")</td>
                                    <td class="text-truncate" style="max-width: 200px;">@i.Location</td>
                                    <td class="text-truncate" style="max-width: 320px;">@i.Description</td>
                                    <td>@FormatMoney(i.RepairCost ?? 0)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



@code {
    private bool _loading = true;
    private string? _error;
    private bool _loadingToday = true;
    private string? _errorToday;

    private readonly List<ViewIncidents> _nearIncidents = new();
    private readonly List<Incident> _todayIncidents = new();

    private int _todayCount;
    private int _rangeCount;
    private string _totalRepairCost = "—";

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;
        _nearIncidents.Clear();
        _loadingToday = true;
        _errorToday = null;
        _todayIncidents.Clear();

        var dateTo = DateOnly.FromDateTime(DateTime.Today);
        var dateFrom = dateTo.AddDays(-7);

        try
        {
            var client = HttpClientFactory.CreateClient("BlazorClient");

            var sessionId = await Key.GetSessionId();

            // 1) Инциденты за последние 7 дней (view)
            var urlRange = $"https://localhost:7011/api/Incidents/IncidentsByDate?dateFrom={dateFrom:yyyy-MM-dd}&dateTo={dateTo:yyyy-MM-dd}";
            var reqRange = new HttpRequestMessage(HttpMethod.Get, urlRange);
            if (!string.IsNullOrWhiteSpace(sessionId))
                reqRange.Headers.Add("X-Session-Id", sessionId);

            var respRange = await client.SendAsync(reqRange);
            if (!respRange.IsSuccessStatusCode)
            {
                _error = $"Ошибка API (IncidentsByDate): {(int)respRange.StatusCode} {respRange.ReasonPhrase}";
            }
            else
            {
                var resultRange = await respRange.Content.ReadFromJsonAsync<List<ViewIncidents>>(
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (resultRange is not null)
                {
                    _nearIncidents.AddRange(resultRange.OrderByDescending(x => x.incident_date).Take(20));
                    _rangeCount = resultRange.Count;
                    _todayCount = resultRange.Count(x => x.incident_date == dateTo);
                    var sum = resultRange.Sum(x => x.repair_cost);
                    _totalRepairCost = FormatMoney(sum);
                }
            }

            // 2) Инциденты за сегодня (по IncidentDate)
            var urlToday = $"https://localhost:7011/api/Incidents/by-date?date={dateTo:yyyy-MM-dd}";
            var reqToday = new HttpRequestMessage(HttpMethod.Get, urlToday);
            if (!string.IsNullOrWhiteSpace(sessionId))
                reqToday.Headers.Add("X-Session-Id", sessionId);

            var respToday = await client.SendAsync(reqToday);
            if (!respToday.IsSuccessStatusCode)
            {
                _errorToday = $"Ошибка API (by-date): {(int)respToday.StatusCode} {respToday.ReasonPhrase}";
            }
            else
            {
                var resultToday = await respToday.Content.ReadFromJsonAsync<List<Incident>>(
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (resultToday is not null)
                    _todayIncidents.AddRange(resultToday.OrderByDescending(x => x.Timestamp));
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            _loadingToday = false;
        }
    }

    private void GoToIncident()
    {
        nav.NavigateTo("/incidents");
    }

    private static string FormatMoney(decimal value)
        => $"{value:N0} ₽";
}