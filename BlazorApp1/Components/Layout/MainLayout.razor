@inherits LayoutComponentBase
@inject SessionService session

<div class="main-layout">

    <!-- верхняя панель-->
    <header class="topbar border-bottom bg-light">

        <div class="d-flex justify-content-center align-items-center h-100 gap-4">

            <a href="/">
                <img src="/Icons/документы.png" class="nav-icon"/>
            </a>

           <a href="/">
                <img src="/Icons/Завяки.png" class="nav-icon"/>
            </a>

            <a href="/">
                <img src="/Icons/отчеты.png" class="nav-icon"/>
            </a>

            <a href="/">
                <img src="/Icons/шаблоны.png" class="nav-icon"/>
            </a>
</div>

    </header>

    <!-- Content-->

    <main class="content">
        @Body
    </main>

    <!--Нижняя панель-->
    <footer class="bottombar border-top bg-light">
        <div class="ps-3">
            @if (session.IsAuthenticated)
{
    <div class="global-footer">
        @session.name (@session.role)
    </div>
}
        </div>
    </footer>
</div>


