@inherits LayoutComponentBase
@inject SessionService session

<div class="page">

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>

</div>

@if (session.IsAuthenticated)
{
    <div class="global-footer">
        @session.name (@session.role)
    </div>
}
